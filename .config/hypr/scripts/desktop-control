#!/usr/bin/env python3
"""Adjust one desktop control and replace its short-lived Mako feedback."""
import argparse
import fcntl
import os
from pathlib import Path
import re
import subprocess


def run(*args):
    return subprocess.run(args, check=True, text=True, capture_output=True, timeout=4).stdout.strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("control", choices=("volume", "mic", "brightness"))
    parser.add_argument("action", choices=("up", "down", "toggle", "mute", "unmute", "show"))
    parser.add_argument("step", nargs="?", type=int, default=5, choices=range(1, 11))
    args = parser.parse_args()
    if args.control == "brightness" and args.action not in ("up", "down", "show"):
        parser.error("brightness supports up, down and show")
    runtime = Path(os.environ["XDG_RUNTIME_DIR"]) / "desktop-feedback"
    runtime.mkdir(mode=0o700, exist_ok=True)
    # Serialize repeats so adjustments and their displayed values stay in order.
    with (runtime / "control.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.control == "brightness":
            if args.action == "up":
                run("brightnessctl", "-d", "amdgpu_bl1", "set", f"+{args.step}%")
            elif args.action == "down":
                run("brightnessctl", "-d", "amdgpu_bl1", "--min-value=1", "set", f"{args.step}%-")
            current = int(run("brightnessctl", "-d", "amdgpu_bl1", "get"))
            maximum = int(run("brightnessctl", "-d", "amdgpu_bl1", "max"))
            value = round(100 * current / maximum)
            title = f"Brightness  {value}%"
        else:
            node = "@DEFAULT_AUDIO_SOURCE@" if args.control == "mic" else "@DEFAULT_AUDIO_SINK@"
            if args.action in ("up", "down"):
                amount = f"{args.step}%" + ("+" if args.action == "up" else "-")
                run("wpctl", "set-volume", "-l", "1", node, amount)
            elif args.action != "show":
                state = {"toggle": "toggle", "mute": "1", "unmute": "0"}[args.action]
                run("wpctl", "set-mute", node, state)
            state = run("wpctl", "get-volume", node)
            match = re.search(r"Volume:\s*([0-9.]+)", state)
            if not match:
                raise ValueError("Could not read the audio volume")
            value = round(float(match[1]) * 100)
            title = "Microphone" if args.control == "mic" else "Volume"
            title += "  muted" if "[MUTED]" in state else f"  {value}%"
            if "[MUTED]" in state:
                value = 0
        # One replaceable transient notification for all controls; no history spam.
        id_file = runtime / "notification-id"
        previous = id_file.read_text().strip() if id_file.exists() else "0"
        if not previous.isdecimal():
            previous = "0"
        ident = run("notify-send", "--app-name=desktop-feedback", "--transient",
                    "--urgency=low", "--expire-time=1400", "--print-id",
                    "--replace-id=" + previous, "--hint=int:value:" + str(min(100, max(0, value))),
                    title)
        if ident.isdecimal():
            id_file.write_text(ident)


if __name__ == "__main__":
    try:
        main()
    except (subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
        raise SystemExit(f"desktop-control: {error}")
