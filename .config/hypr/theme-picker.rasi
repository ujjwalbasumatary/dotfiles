/* Appearance picker; the application launcher retains its search field. */
@theme "/home/ujjwal/.config/hypr/rofi.rasi"
window { width: 380px; padding: 16px; }
mainbox { children: [ listview ]; }
listview { lines: 2; fixed-height: true; spacing: 4px; }
element { children: [ element-text ]; padding: 12px; }
