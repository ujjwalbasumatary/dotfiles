<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkMenu" id="menu">
    <property name="name">waybar-controls-menu</property>
    <property name="visible">True</property>
    <child>
      <object class="GtkMenuItem" id="menu_title">
        <property name="label">Microphone</property>
        <property name="sensitive">False</property>
        <property name="visible">True</property>
        <style>
          <class name="controls-title" />
        </style>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="microphone_mute">
        <property name="label">Mute microphone</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="microphone_unmute">
        <property name="label">Unmute microphone</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" id="separator_2">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="microphone_up">
        <property name="label">Input level +5%</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="microphone_down">
        <property name="label">Input level −5%</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" id="separator_5">
        <property name="visible">True</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="input_settings">
        <property name="label">Input devices…</property>
        <property name="visible">True</property>
      </object>
    </child>
  </object>
</interface>
