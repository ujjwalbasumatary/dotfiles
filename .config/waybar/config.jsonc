{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "height": 44,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 2,
  "modules-left": [
    "clock",
    "custom/weather",
    "hyprland/window",
    "idle_inhibitor"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "backlight",
    "bluetooth",
    "pulseaudio#output",
    "pulseaudio#input",
    "network",
    "battery"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by": "number",
    "enable-bar-scroll": false,
    "all-outputs": false,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 16,
    "separate-outputs": true,
    "rewrite": {
      "(.*) - Mozilla Firefox": "$1",
      "(.*) - Google Chrome": "$1",
      "(.*) - kitty": "$1"
    }
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}%",
    "on-click": "kitty -e htop"
  },
  "memory": {
    "interval": 5,
    "format": "<span foreground=\"#f6c177\">MEM</span> {percentage}%",
    "on-click": "kitty -e htop"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d %b %H:%M}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#e0def4'><b>{}</b></span>",
        "weekdays": "<span color='#f6c177'><b>{}</b></span>",
        "today": "<span color='#eb6f92'><b>{}</b></span>"
      }
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "idle"
    },
    "tooltip-format-activated": "Keep awake enabled: automatic lock and display sleep paused",
    "tooltip-format-deactivated": "Normal idle timers: lock after 10 minutes, display off after 11"
  },
  "network": {
    "format": "net",
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "lan",
    "format-disconnected": "off",
    "tooltip-format-wifi": "{essid} \u00b7 {signalStrength}%\n{ipaddr}\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "menu": "on-click",
    "menu-file": "/home/ujjwal/.config/waybar/menus/network.xml",
    "menu-actions": {
      "wifi_enable": "nmcli radio wifi on",
      "wifi_disable": "nmcli radio wifi off",
      "network_connect": "kitty -o font_size=12 --class waybar-network -e nmtui-connect",
      "network_advanced": "nm-connection-editor"
    }
  },
  "battery": {
    "format": "{capacity}%",
    "format-discharging": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "format-full": "{capacity}%",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "bat": "BAT1",
    "adapter": "ACAD"
  },
  "bluetooth": {
    "format": "on",
    "format-disabled": "off",
    "format-off": "off",
    "format-connected": "{num_connections}",
    "tooltip-format": "Devices connected: {num_connections}\nClick: quick controls",
    "menu": "on-click",
    "menu-file": "/home/ujjwal/.config/waybar/menus/bluetooth.xml",
    "menu-actions": {
      "bluetooth_enable": "bluetoothctl power on",
      "bluetooth_disable": "bluetoothctl power off",
      "bluetooth_devices": "kitty -o font_size=12 --class waybar-bluetooth -e bluetoothctl"
    }
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "tooltip-format": "{percent}%",
    "on-scroll-up": "/home/ujjwal/.config/hypr/scripts/desktop-control brightness up 5",
    "on-scroll-down": "/home/ujjwal/.config/hypr/scripts/desktop-control brightness down 5"
  },
  "pulseaudio#input": {
    "format-source": "on",
    "format-source-muted": "off",
    "format": "{format_source}",
    "tooltip-format": "Microphone: {source_volume}%\nClick: quick controls \u00b7 right click: mute",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click-right": "/home/ujjwal/.config/hypr/scripts/desktop-control mic toggle",
    "on-scroll-up": "/home/ujjwal/.config/hypr/scripts/desktop-control mic up 1",
    "on-scroll-down": "/home/ujjwal/.config/hypr/scripts/desktop-control mic down 1",
    "menu": "on-click",
    "menu-file": "/home/ujjwal/.config/waybar/menus/audio-input.xml",
    "menu-actions": {
      "microphone_mute": "/home/ujjwal/.config/hypr/scripts/desktop-control mic mute",
      "microphone_unmute": "/home/ujjwal/.config/hypr/scripts/desktop-control mic unmute",
      "microphone_up": "/home/ujjwal/.config/hypr/scripts/desktop-control mic up",
      "microphone_down": "/home/ujjwal/.config/hypr/scripts/desktop-control mic down",
      "input_settings": "pavucontrol -t 4"
    }
  },
  "pulseaudio#output": {
    "format": "{volume}%",
    "tooltip-format": "Volume: {volume}%\nClick: quick controls \u00b7 right click: mute",
    "format-muted": "off",
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click-right": "/home/ujjwal/.config/hypr/scripts/desktop-control volume toggle",
    "menu": "on-click",
    "menu-file": "/home/ujjwal/.config/waybar/menus/audio-output.xml",
    "menu-actions": {
      "speaker_mute": "/home/ujjwal/.config/hypr/scripts/desktop-control volume mute",
      "speaker_unmute": "/home/ujjwal/.config/hypr/scripts/desktop-control volume unmute",
      "speaker_up": "/home/ujjwal/.config/hypr/scripts/desktop-control volume up",
      "speaker_down": "/home/ujjwal/.config/hypr/scripts/desktop-control volume down",
      "output_settings": "pavucontrol -t 3"
    },
    "on-scroll-up": "/home/ujjwal/.config/hypr/scripts/desktop-control volume up 2",
    "on-scroll-down": "/home/ujjwal/.config/hypr/scripts/desktop-control volume down 2"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "mpris": {
    "format": "{artist} - {title}",
    "format-paused": "paused \u00b7 {artist}",
    "max-length": 16,
    "ignored-players": [
      "firefox",
      "chromium",
      "brave"
    ],
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "tooltip-format": "{artist} \u00b7 {title}"
  },
  "spacing": 0,
  "fixed-center": true,
  "custom/weather": {
    "exec": "/home/ujjwal/.config/hypr/scripts/weather --waybar",
    "return-type": "json",
    "interval": 300,
    "tooltip": true
  }
}
